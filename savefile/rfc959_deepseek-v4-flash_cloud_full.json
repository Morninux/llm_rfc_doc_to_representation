{
  "rfc": "959",
  "model": "deepseek-v4-flash:cloud",
  "method": "full",
  "output": {
    "protocol": "File Transfer Protocol",
    "rfc": "RFC 959",
    "pdus": [
      "page",
      "block",
      "compressed_regular_data",
      "compressed_replicated_byte",
      "compressed_filler_string",
      "compressed_escape_sequence",
      "stream_record_control"
    ],
    "bit_string_types": [
      {
        "name": "byte",
        "size_bits": 8,
        "description": "8-bit transfer byte."
      },
      {
        "name": "uint16",
        "size_bits": 16,
        "description": "16-bit unsigned integer in network byte order."
      },
      {
        "name": "logical_byte",
        "size_bits": null,
        "description": "One logical byte. Size depends on the representation type (TYPE command)."
      }
    ],
    "enumerated_types": [
      {
        "name": "page_type",
        "variants": [
          {
            "name": "last_page",
            "type": "logical_byte",
            "condition": "value == 0"
          },
          {
            "name": "simple_page",
            "type": "logical_byte",
            "condition": "value == 1"
          },
          {
            "name": "descriptor_page",
            "type": "logical_byte",
            "condition": "value == 2"
          },
          {
            "name": "access_controlled_page",
            "type": "logical_byte",
            "condition": "value == 3"
          }
        ]
      },
      {
        "name": "compressed_segment_kind",
        "variants": [
          {
            "name": "regular_data",
            "type": "compressed_regular_data",
            "condition": "count_byte & 0x80 == 0"
          },
          {
            "name": "replicated_byte",
            "type": "compressed_replicated_byte",
            "condition": "count_byte & 0xC0 == 0x80"
          },
          {
            "name": "filler_string",
            "type": "compressed_filler_string",
            "condition": "count_byte & 0xC0 == 0xC0"
          },
          {
            "name": "escape_sequence",
            "type": "compressed_escape_sequence",
            "condition": "count_byte == 0"
          }
        ]
      }
    ],
    "structure_types": [
      {
        "name": "page",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "header_length",
            "display_name": "Header Length",
            "offset_bits": null,
            "size_bits": null,
            "type": "logical_byte",
            "optional": false,
            "presence_condition": null,
            "description": "Number of logical bytes in the page header including this byte. Minimum 4.",
            "constraints": [
              "header_length >= 4"
            ]
          },
          {
            "name": "page_index",
            "display_name": "Page Index",
            "offset_bits": null,
            "size_bits": null,
            "type": "logical_byte",
            "optional": false,
            "presence_condition": null,
            "description": "Logical page number of this section of the file.",
            "constraints": []
          },
          {
            "name": "data_length",
            "display_name": "Data Length",
            "offset_bits": null,
            "size_bits": null,
            "type": "logical_byte",
            "optional": false,
            "presence_condition": null,
            "description": "Number of logical bytes in the page data. Minimum 0.",
            "constraints": [
              "data_length >= 0"
            ]
          },
          {
            "name": "page_type",
            "display_name": "Page Type",
            "offset_bits": null,
            "size_bits": null,
            "type": "page_type",
            "optional": false,
            "presence_condition": null,
            "description": "Type of page.",
            "constraints": []
          },
          {
            "name": "access_control",
            "display_name": "Page Access Control",
            "offset_bits": null,
            "size_bits": null,
            "type": "logical_byte",
            "optional": true,
            "presence_condition": "page_type == 3",
            "description": "Access bits associated with the page. Present only for Access Controlled Page (type 3).",
            "constraints": []
          }
        ],
        "payload": {
          "name": "data",
          "offset_bits": null,
          "size": "data_length"
        },
        "constraints": [
          "header_length >= 4",
          "data_length >= 0",
          "page_type == 3 => header_length == 5"
        ],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "block",
        "header_size_bytes": 3,
        "byte_order": "big-endian",
        "fields": [
          {
            "name": "descriptor",
            "display_name": "Descriptor",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Descriptor codes as bit flags. Bits: 128 EOR, 64 EOF, 32 suspect errors, 16 restart marker.",
            "constraints": []
          },
          {
            "name": "byte_count",
            "display_name": "Byte Count",
            "offset_bits": 8,
            "size_bits": 16,
            "type": "uint16",
            "optional": false,
            "presence_condition": null,
            "description": "Total length of the data block in bytes.",
            "constraints": []
          }
        ],
        "payload": {
          "name": "data",
          "offset_bits": 24,
          "size": "byte_count"
        },
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "compressed_regular_data",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "count_byte",
            "display_name": "Count Byte",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Left-most bit 0, right-most 7 bits contain number n of data bytes.",
            "constraints": [
              "count_byte & 0x80 == 0",
              "count_byte & 0x7F > 0"
            ]
          },
          {
            "name": "data",
            "display_name": "Data",
            "offset_bits": 8,
            "size_bits": null,
            "type": "compressed_data",
            "optional": false,
            "presence_condition": null,
            "description": "n data bytes.",
            "constraints": []
          }
        ],
        "payload": null,
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "compressed_replicated_byte",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "count_byte",
            "display_name": "Count Byte",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Left-most bits 10, right-most 6 bits contain number n of replications.",
            "constraints": [
              "count_byte & 0xC0 == 0x80"
            ]
          },
          {
            "name": "data_byte",
            "display_name": "Data Byte",
            "offset_bits": 8,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "The byte to be replicated n times.",
            "constraints": []
          }
        ],
        "payload": null,
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "compressed_filler_string",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "count_byte",
            "display_name": "Count Byte",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Left-most bits 11, right-most 6 bits contain number n of filler bytes.",
            "constraints": [
              "count_byte & 0xC0 == 0xC0"
            ]
          }
        ],
        "payload": null,
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "compressed_escape_sequence",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "escape_byte",
            "display_name": "Escape Byte",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "All zeros.",
            "constraints": [
              "escape_byte == 0"
            ]
          },
          {
            "name": "descriptor_byte",
            "display_name": "Descriptor Byte",
            "offset_bits": 8,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Descriptor codes as in Block mode.",
            "constraints": []
          }
        ],
        "payload": null,
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      },
      {
        "name": "stream_record_control",
        "header_size_bytes": null,
        "byte_order": null,
        "fields": [
          {
            "name": "escape_byte",
            "display_name": "Escape Byte",
            "offset_bits": 0,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "All ones (0xFF).",
            "constraints": [
              "escape_byte == 0xFF"
            ]
          },
          {
            "name": "control_byte",
            "display_name": "Control Byte",
            "offset_bits": 8,
            "size_bits": 8,
            "type": "byte",
            "optional": false,
            "presence_condition": null,
            "description": "Low order bits: bit0 EOR, bit1 EOF, both for both.",
            "constraints": []
          }
        ],
        "payload": null,
        "constraints": [],
        "parse_from": null,
        "serialize_to": null
      }
    ],
    "array_types": [
      {
        "name": "block_data",
        "element_type": "byte",
        "length": "byte_count"
      },
      {
        "name": "page_data",
        "element_type": "byte",
        "length": "data_length"
      },
      {
        "name": "compressed_data",
        "element_type": "byte",
        "length": "count_byte & 0x7F"
      }
    ],
    "parsing_context": [
      {
        "name": "logical_byte_size",
        "type": "integer",
        "description": "The logical byte size as specified by the TYPE command."
      },
      {
        "name": "transfer_mode",
        "type": "string",
        "description": "The transfer mode (Stream, Block, Compressed) specified by MODE command."
      },
      {
        "name": "file_structure",
        "type": "string",
        "description": "The file structure (File, Record, Page) specified by STRU command."
      },
      {
        "name": "representation_type",
        "type": "string",
        "description": "The representation type (ASCII, EBCDIC, Image, Local) specified by TYPE command."
