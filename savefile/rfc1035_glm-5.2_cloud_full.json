        "description": "The complete DNS message is required as parsing context for message compression. Compression pointers reference offsets from the start of the message (the first octet of the ID field). A domain name may be a sequence of labels ending in a zero octet, a pointer, or a sequence of labels ending with a pointer."
      },
      {
        "name": "label_length_high_bits",
        "type": "constraint",
        "description": "The high order two bits of every length octet in a label must be zero, limiting labels to 63 octets or less. If the high order two bits are both ones, the octet is a compression pointer."
      }
    ],
    "helper_functions": [
      {
        "name": "parse_domain_name",
        "description": "Parses a domain name from a message, handling compression pointers. A domain name is represented as a sequence of labels where each label consists of a length octet followed by that number of octets, terminated by a zero length octet. Compression pointers (two octets with first two bits set to 11) reference a prior occurance at an offset from the start of the message."
      },
      {
        "name": "parse_character_string",
        "description": "Parses a character-string, which is a single length octet followed by that number of characters. Can be up to 256 characters in length including the length octet."
      }
