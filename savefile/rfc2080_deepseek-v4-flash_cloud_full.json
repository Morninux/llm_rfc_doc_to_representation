{
  "protocol": "RIPng for IPv6",
  "rfc": "RFC 2080",
  "packet": [
    {
      "name": "RIPng Message Format",
      "pdus": [
        "RIPng Message"
      ],
      "bit_string_types": [
        {
          "name": "command",
          "size_bits": 8,
          "description": "Specifies the purpose of the message: 1 request, 2 response."
        },
        {
          "name": "version",
          "size_bits": 8,
          "description": "RIPng version number; this document describes version 1."
        },
        {
          "name": "must_be_zero",
          "size_bits": 16,
          "description": "Must be zero."
        }
      ],
      "enumerated_types": [
        {
          "name": "Command",
          "variants": [
            {
              "name": "request",
              "type": "integer",
              "condition": "value == 1"
            },
            {
              "name": "response",
              "type": "integer",
              "condition": "value == 2"
            }
          ]
        },
        {
          "name": "Route Table Entry",
          "variants": [
            {
              "name": "normal_rte",
              "type": "Route Table Entry",
              "condition": "metric != 0xFF"
            },
            {
              "name": "next_hop_rte",
              "type": "Next Hop Route Table Entry",
              "condition": "metric == 0xFF"
            }
          ]
        }
      ],
      "structure_types": [
        {
          "name": "RIPng Message",
          "header_size_bytes": 4,
          "byte_order": "big-endian",
          "fields": [
            {
              "name": "command",
              "display_name": "Command",
              "offset_bits": 0,
              "size_bits": 8,
              "type": "command",
              "optional": null,
              "presence_condition": null,
              "description": "Specifies the purpose of this message.",
              "constraints": [
                "command == 1 or command == 2"
              ]
            },
            {
              "name": "version",
              "display_name": "Version",
              "offset_bits": 8,
              "size_bits": 8,
              "type": "version",
              "optional": null,
              "presence_condition": null,
              "description": "Version of RIPng; version 1 is described in this document.",
              "constraints": [
                "version == 1"
              ]
            },
            {
              "name": "must_be_zero",
              "display_name": "Must Be Zero",
              "offset_bits": 16,
              "size_bits": 16,
              "type": "must_be_zero",
              "optional": null,
              "presence_condition": null,
              "description": "Must be zero.",
              "constraints": [
                "must_be_zero == 0"
              ]
            }
          ],
          "payload": {
            "name": "route_table_entries",
            "offset_bits": 32,
            "size": "N * 160"
          },
          "constraints": [
            "N >= 0",
            "N <= floor((mtu - ipv6_header_size - udp_header_length - 4) / 20)"
          ],
          "parse_from": null,
          "serialize_to": null
        }
      ],
      "array_types": [
        {
          "name": "route_table_entries",
          "element_type": "Route Table Entry",
          "length": null
        }
      ],
      "parsing_context": [
        {
          "name": "mtu",
          "type": "integer",
          "description": "Maximum transmission unit of the medium, used to determine the maximum number of RTEs."
        },
        {
          "name": "ipv6_header_size",
          "type": "integer",
          "description": "Size in octets of IPv6 header(s) preceding the RIPng message."
        },
        {
          "name": "udp_header_length",
          "type": "integer",
          "description": "Size in octets of the UDP header."
        },
        {
          "name": "current_next_hop",
          "type": "IPv6 address",
          "description": "Next hop address from the most recent next hop RTE; applies to subsequent RTEs until another next hop RTE or end of message."
        }
      ],
      "helper_functions": [
        {
          "name": "calculate_max_rtes",
          "description": "Computes the maximum number of RTEs: INT((MTU - sizeof(IPv6_hdrs) - UDP_hdrlen - RIPng_hdrlen) / RTE_size)."
        },
        {
          "name": "is_next_hop_rte",
          "description": "Returns true if the metric field of an RTE equals 0xFF, identifying a next hop RTE."
        }
      ],
      "transform_functions": []
    },
    {
      "name": "Route Table Entry Format",
      "pdus": [
        "Route Table Entry"
      ],
      "bit_string_types": [
        {
          "name": "ipv6_prefix",
          "size_bits": 128,
          "description": "IPv6 destination prefix, 16 octets in network byte order."
        },
        {
          "name": "route_tag",
          "size_bits": 16,
          "description": "Route tag attribute assigned to a route, preserved and readvertised."
        },
        {
          "name": "prefix_length",
          "size_bits": 8,
          "description": "Length in bits of the significant part of the prefix, 0 to 128 inclusive."
        },
        {
          "name": "metric",
          "size_bits": 8,
          "description": "Route metric, 1 to 15 inclusive, or 16 for infinity (unreachable)."
        }
      ],
      "enumerated_types": [],
      "structure_types": [
        {
          "name": "Route Table Entry",
          "header_size_bytes": null,
          "byte_order": "big-endian",
          "fields": [
            {
              "name": "ipv6_prefix",
              "display_name": "IPv6 Prefix",
              "offset_bits": 0,
              "size_bits": 128,
              "type": "ipv6_prefix",
              "optional": null,
              "presence_condition": null,
              "description": "The 128-bit IPv6 address prefix stored as 16 octets.",
              "constraints": []
            },
            {
              "name": "route_tag",
              "display_name": "Route Tag",
              "offset_bits": 128,
              "size_bits": 16,
              "type": "route_tag",
              "optional": null,
              "presence_condition": null,
              "description": "Attribute assigned to a route, preserved and readvertised.",
              "constraints": []
            },
            {
              "name": "prefix_length",
              "display_name": "Prefix Length",
              "offset_bits": 144,
              "size_bits": 8,
              "type": "prefix_length",
              "optional": null,
              "presence_condition": null,
              "description": "Number of significant bits in the prefix, starting from the left.",
              "constraints": [
                "0 <= prefix_length <= 128"
              ]
            },
            {
              "name": "metric",
              "display_name": "Metric",
              "offset_bits": 152,
              "size_bits": 8,
              "type": "metric",
              "optional": null,
              "presence_condition": null,
              "description": "Current metric for the destination, or 16 for infinity.",
              "constraints": [
                "1 <= metric <= 16"
              ]
            }
          ],
          "payload": {
            "name": "none",
            "offset_bits": null,
            "size": null
          },
          "constraints": [
            "prefix_length >= 0 and prefix_length <= 128",
            "metric >= 1 and metric <= 16"
          ],
          "parse_from": null,
          "serialize_to": null
        }
      ],
      "array_types": [],
      "parsing_context": [],
      "helper_functions": [],
      "transform_functions": []
    },
    {
      "name": "Next Hop Route Table Entry Format",
      "pdus": [
        "Next Hop Route Table Entry"
      ],
      "bit_string_types": [
        {
          "name": "ipv6_next_hop_address",
          "size_bits": 128,
          "description": "IPv6 address of the immediate next hop; 0:0:0:0:0:0:0:0 means the originator of the advertisement."
        },
        {
          "name": "must_be_zero_16",
          "size_bits": 16,
          "description": "Must be zero on sending and ignored on reception."
        },
        {
          "name": "must_be_zero_8",
          "size_bits": 8,
          "description": "Must be zero on sending and ignored on reception."
        },
        {
          "name": "next_hop_metric",
          "size_bits": 8,
          "description": "Value 0xFF identifies this RTE as a next hop RTE."
        }
      ],
      "enumerated_types": [],
      "structure_types": [
        {
          "name": "Next Hop Route Table Entry",
          "header_size_bytes": null,
          "byte_order": "big-endian",
          "fields": [
            {
              "name": "ipv6_next_hop_address",
              "display_name": "IPv6 Next Hop Address",
              "offset_bits": 0,
              "size_bits": 128,
              "type": "ipv6_next_hop_address",
              "optional": null,
              "presence_condition": null,
              "description": "IPv6 address of the next hop; must be link-local, or zero to indicate the originator.",
              "constraints": [
                "ipv6_next_hop_address is link-local or 0:0:0:0:0:0:0:0"
              ]
            },
            {
              "name": "must_be_zero_1",
              "display_name": "Must Be Zero",
              "offset_bits": 128,
              "size_bits": 16,
              "type": "must_be_zero_16",
              "optional": null,
              "presence_condition": null,
              "description": "Must be zero on sending and ignored on reception.",
              "constraints": [
                "must_be_zero_1 == 0"
              ]
            },
            {
              "name": "must_be_zero_2",
              "display_name": "Must Be Zero",
              "offset_bits": 144,
              "size_bits": 8,
              "type": "must_be_zero_8",
              "optional": null,
              "presence_condition": null,
              "description": "Must be zero on sending and ignored on reception.",
              "constraints": [
                "must_be_zero_2 == 0"
              ]
            },
            {
              "name": "next_hop_metric",
              "display_name": "Next Hop Metric (0xFF)",
              "offset_bits": 152,
              "size_bits": 8,
              "type": "next_hop_metric",
              "optional": null,
              "presence_condition": null,
              "description": "Fixed value 0xFF identifying a next hop RTE.",
              "constraints": [
                "next_hop_metric == 0xFF"
              ]
            }
          ],
          "payload": {
            "name": "none",
            "offset_bits": null,
            "size": null
          },
          "constraints": [
            "next_hop_metric == 0xFF",
            "must_be_zero_1 == 0",
            "must_be_zero_2 == 0"
          ],
          "parse_from": null,
          "serialize_to": null
        }
      ],
      "array_types": [],
      "parsing_context": [],
      "helper_functions": [],
      "transform_functions": []
    }
  ]
}
